{
  "appId": "com.subcraft.app",
  "productName": "SubCraft",
  "directories": {
    "output": "../release/linux"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "../backend/dist/subcraft-backend",
      "to": "backend/subcraft-backend"
    },
    {
      "from": "../tools/ffmpeg",
      "to": "tools/ffmpeg",
      "filter": [
        "**/*",
        "!ffplay*"
      ]
    },
    {
      "from": "../backend/app",
      "to": "backend/app"
    },
    {
      "from": "../backend/run.py",
      "to": "backend/run.py"
    },
    {
      "from": "../backend/requirements.txt",
      "to": "backend/requirements.txt"
    }
  ],
  "linux": {
    "target": [
      "tar.gz"
    ],
    "executableName": "SubCraft",
    "category": "AudioVideo",
    "artifactName": "SubCraft-${version}-x64-linux.tar.gz"
  }
}
